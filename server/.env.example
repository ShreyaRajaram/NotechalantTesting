# Copy this file to .env and fill it in. .env is gitignored, so the key never gets committed.

# Free key from Google AI Studio
GEMINI_API_KEY=

# Flash-Lite answers in about 1s. Flash allowed only 5 requests per minute on the free tier, which auto transcribe hits fast.
GEMINI_MODEL=gemini-3.5-flash-lite

PORT=8787

# Datadog LLM Observability (optional, server-side only). No Agent is required.
# Use a Datadog API key, not the browser RUM client token. Enable LLM Observability
# in the Datadog organization that owns this key.
DD_LLMOBS_ENABLED=false
DD_API_KEY=
DD_SITE=datadoghq.com
DD_LLMOBS_ML_APP=notechalant
DD_SERVICE=notechalanttesting
DD_ENV=development
DD_VERSION=0.1.0

# Opt in to sending prompt and answer text (up to 16,000 characters each).
# Images are always omitted. Text can include student notes and document text.
DD_LLMOBS_CAPTURE_CONTENT=false
